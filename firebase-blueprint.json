{
  "entities": {
    "Location": {
      "title": "Location",
      "description": "A place where padel classes are held",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the location" },
        "teacher_id": { "type": "string", "description": "ID of the teacher who owns this location" }
      },
      "required": ["name", "teacher_id"]
    },
    "Slot": {
      "title": "Slot",
      "description": "An available time slot for a class",
      "type": "object",
      "properties": {
        "location_id": { "type": "string", "description": "ID of the location" },
        "teacher_id": { "type": "string", "description": "ID of the teacher who owns this slot" },
        "date": { "type": "string", "format": "date", "description": "Date of the slot (YYYY-MM-DD)" },
        "time": { "type": "string", "description": "Time of the slot (HH:MM)" },
        "is_available": { "type": "boolean", "description": "Whether the slot is available for booking" }
      },
      "required": ["location_id", "teacher_id", "date", "time", "is_available"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A student's reservation for a slot",
      "type": "object",
      "properties": {
        "slot_id": { "type": "string", "description": "ID of the booked slot" },
        "teacher_id": { "type": "string", "description": "ID of the teacher who owns this booking" },
        "student_name": { "type": "string", "description": "Name of the student" },
        "student_phone": { "type": "string", "description": "Phone number of the student" },
        "booking_type": { "type": "string", "description": "Type of class (Individual, Dupla, etc.)" },
        "price": { "type": "number", "description": "Price of the booking" },
        "paid": { "type": "boolean", "description": "Whether the booking has been paid" },
        "date": { "type": "string", "format": "date", "description": "Date of the class" },
        "time": { "type": "string", "description": "Time of the class" },
        "location_name": { "type": "string", "description": "Name of the location at the time of booking" },
        "google_event_id": { "type": "string", "description": "ID of the corresponding Google Calendar event" },
        "google_synced": { "type": "boolean", "description": "Whether the booking has been synced to Google Calendar" }
      },
      "required": ["slot_id", "teacher_id", "student_name", "student_phone", "booking_type", "price", "paid", "date", "time", "location_name"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Application configurations",
      "type": "object",
      "properties": {
        "teacher_id": { "type": "string", "description": "ID of the teacher who owns these settings" },
        "whatsapp_number": { "type": "string", "description": "Phone number to receive notifications" },
        "google_script_url": { "type": "string", "description": "URL of the Google Apps Script to create events" }
      },
      "required": ["teacher_id", "whatsapp_number"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "A Padel or Beach Tennis tournament detail",
      "type": "object",
      "properties": {
        "teacher_id": { "type": "string", "description": "ID of the teacher/admin who created the tournament" },
        "name": { "type": "string", "description": "Name of the tournament" },
        "type": { "type": "string", "enum": ["padel", "beach"], "description": "Type of sports tournament" },
        "rules": { "type": "string", "description": "Rules of the tournament" },
        "locations": { "type": "array", "description": "List of location names for tournament games" },
        "times": { "type": "array", "description": "List of time schedules for matches" },
        "dates": { "type": "array", "description": "List of dates for matches" },
        "categories": { "type": "array", "description": "List of categories" },
        "created_at": { "type": "string", "description": "Date/Time in ISO format" }
      },
      "required": ["teacher_id", "name", "type"]
    },
    "TournamentTeam": {
      "title": "TournamentTeam",
      "description": "A double/team participating in a category and group",
      "type": "object",
      "properties": {
        "tournament_id": { "type": "string", "description": "Associated tournament ID" },
        "category": { "type": "string", "description": "E.g., Masculina B, Feminina Open" },
        "group_name": { "type": "string", "description": "E.g., Chave A, Chave B" },
        "player1_name": { "type": "string", "description": "Name of first player" },
        "player1_phone": { "type": "string", "description": "WhatsApp contact of first player" },
        "player2_name": { "type": "string", "description": "Name of second player" },
        "player2_phone": { "type": "string", "description": "WhatsApp contact of second player" }
      },
      "required": ["tournament_id", "category", "group_name", "player1_name"]
    },
    "TournamentMatch": {
      "title": "TournamentMatch",
      "description": "A direct game match scheduled between two teams",
      "type": "object",
      "properties": {
        "tournament_id": { "type": "string", "description": "Tournament ID" },
        "category": { "type": "string", "description": "Category of the match" },
        "stage": { "type": "string", "description": "E.g., Chave A, Semifinal, Final" },
        "team1_id": { "type": "string", "description": "ID of team 1" },
        "team1_name": { "type": "string", "description": "Name representation of team 1" },
        "team2_id": { "type": "string", "description": "ID of team 2" },
        "team2_name": { "type": "string", "description": "Name representation of team 2" },
        "score1_sets": { "type": "array", "description": "Sets result of team 1" },
        "score2_sets": { "type": "array", "description": "Sets result of team 2" },
        "score1_text": { "type": "string", "description": "Detailed display text score of team 1" },
        "score2_text": { "type": "string", "description": "Detailed display text score of team 2" },
        "date": { "type": "string", "format": "date", "description": "Scheduled date" },
        "time": { "type": "string", "description": "Scheduled hour" },
        "location": { "type": "string", "description": "Scheduled court/location" },
        "status": { "type": "string", "enum": ["agendado", "em_andamento", "encerrado"], "description": "Current status of the match" },
        "winner_id": { "type": "string", "description": "Winning team ID" }
      },
      "required": ["tournament_id", "category", "stage", "team1_name", "team2_name", "status"]
    }
  },
  "firestore": {
    "/locations/{locationId}": {
      "schema": "Location",
      "description": "Collection of locations"
    },
    "/slots/{slotId}": {
      "schema": "Slot",
      "description": "Collection of all time slots"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Collection of all bookings"
    },
    "/settings/{settingId}": {
      "schema": "AppSettings",
      "description": "Collection of app settings"
    },
    "/tournaments/{tournamentId}": {
      "schema": "Tournament",
      "description": "Collection of tournaments"
    },
    "/tournament_teams/{teamId}": {
      "schema": "TournamentTeam",
      "description": "Teams inside tournaments"
    },
    "/tournament_matches/{matchId}": {
      "schema": "TournamentMatch",
      "description": "Matches in tournaments"
    }
  }
}
